#!/bin/sh
# PuntoTruco bootstrap: downloads Gradle 8.11.1 if not installed.
set -eu
cd "$(dirname "$0")"
VERSION=8.11.1
DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/puntotruco-bootstrap"
BIN="$DIR/gradle-$VERSION/bin/gradle"
if [ ! -x "$BIN" ]; then
  mkdir -p "$DIR"
  ARCHIVE="$DIR/gradle-$VERSION-bin.zip"
  URL="https://services.gradle.org/distributions/gradle-$VERSION-bin.zip"
  if command -v curl >/dev/null 2>&1; then curl -fL --retry 3 -o "$ARCHIVE" "$URL"; else wget -O "$ARCHIVE" "$URL"; fi
  unzip -q -o "$ARCHIVE" -d "$DIR"
  rm -f "$ARCHIVE"
fi
exec "$BIN" "$@"
